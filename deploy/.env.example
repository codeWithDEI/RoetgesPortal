# Canonical public hostname used for the portal and automatic HTTPS.
SITE_ADDRESS=roetgesportal.de
CANONICAL_ORIGIN=https://roetgesportal.de

# Additional hostnames that permanently redirect to the canonical origin.
REDIRECT_SITE_ADDRESSES="www.roetgesportal.de preview.roetgesportal.de"

# Host ports exposed by the reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

# The analytics dashboard only listens on the server's loopback interface.
# Open it through an SSH tunnel; do not expose this port in the firewall.
ANALYTICS_PORT=8082
ANALYTICS_REFRESH_SECONDS=300

# Required legal/operator values. Replace every neutral placeholder in the
# untracked deploy/.env before starting any public deployment.
LEGAL_OPERATOR_NAME="<vollständiger Name>"
LEGAL_OPERATOR_STREET="<Straße und Hausnummer>"
LEGAL_OPERATOR_POSTAL_CODE="<fünfstellige PLZ>"
LEGAL_OPERATOR_CITY="<Ort>"
LEGAL_CONTACT_EMAIL="<Kontakt-E-Mail>"

# Copy the exact contracting entity and contract facts; do not infer them from
# an IP address. The two information fields are displayed as complete sentences.
LEGAL_HOSTING_PROVIDER_NAME="<vollständige Firma des Hostinganbieters>"
LEGAL_HOSTING_PROCESSING_LOCATIONS="<vertraglich vereinbarte Länder oder Regionen>"
LEGAL_HOSTING_RETENTION_INFORMATION="<Speicher- und Löschfristen des Hostinganbieters als vollständiger Satz>"
LEGAL_HOSTING_THIRD_COUNTRY_INFORMATION="<Drittlandübermittlungen und Garantien oder deren Ausschluss als vollständiger Satz>"

# The mail provider must match the contract or account used for the public
# contact mailbox. Do not infer the contracting entity from the email domain.
LEGAL_EMAIL_PROVIDER_NAME="<vollständige Firma des Mailanbieters>"
LEGAL_EMAIL_PROCESSING_LOCATIONS="<vertraglich vorgesehene Länder oder Regionen des Mailanbieters>"
LEGAL_EMAIL_THIRD_COUNTRY_INFORMATION="<Drittlandübermittlungen und Garantien des Mailanbieters oder deren Ausschluss als vollständiger Satz>"
