# Canonical public hostname used for the portal and automatic HTTPS.
SITE_ADDRESS=roetgesportal.de
CANONICAL_ORIGIN=https://roetgesportal.de

# Additional hostnames that permanently redirect to the canonical origin.
REDIRECT_SITE_ADDRESSES="www.roetgesportal.de preview.roetgesportal.de"

# Host ports exposed by the reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

# The analytics dashboard only listens on the server's loopback interface.
# Open it through an SSH tunnel; do not expose this port in the firewall.
ANALYTICS_PORT=8082
ANALYTICS_REFRESH_SECONDS=300
