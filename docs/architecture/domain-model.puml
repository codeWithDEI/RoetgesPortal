@startuml
title RötgesPortal – Domain Model

skinparam classAttributeIconSize 0
skinparam shadowing false

class Topic {
  +id: string
  +title: string
  +summary: markdown
  +description: markdown
  +status: TopicStatus
  +visibility: Visibility
  +createdAt: date
  +updatedAt: date
  +lastVerifiedAt: date
}

enum TopicStatus {
  idea
  announced
  consultation
  committee
  council
  decided
  implementation
  completed
  paused
  rejected
}

enum Visibility {
  draft
  published
  archived
}

class Dataset {
  +id: string
  +title: string
  +description: string
  +type: DatasetType
  +path: path
  +normalization: string
}

enum DatasetType {
  topics
  geojson
}

class View {
  +id: string
  +title: string
  +description: string
  +route: path
  +visibility: Visibility
}

class MapConfiguration {
  +longitude: number
  +latitude: number
  +zoom: integer
  +minZoom: integer
  +maxZoom: integer
}

class Layer {
  +id: string
  +title: string
  +visibleByDefault: boolean
  +clustering: boolean
}

class ViewFilter {
  +visibility: Visibility[]
  +status: TopicStatus[]
  +categories: string[]
  +organizations: string[]
}

class Presentation {
  +preset: string
}

class ImpactLocation {
  +id: string
  +label: string
  +geoJsonFile: path
  +impactType: ImpactType
}

enum ImpactType {
  direct
  indirect
  affectedArea
  alternative
}

class Milestone {
  +date: date
  +title: string
  +description: string
  +status: MilestoneStatus
}

enum MilestoneStatus {
  planned
  reached
  postponed
  cancelled
}

class Source {
  +title: string
  +url: uri
  +sourceType: SourceType
  +publishedAt: date
  +accessedAt: date
}

enum SourceType {
  agenda
  proposal
  minutes
  resolution
  budget
  planningDocument
  pressRelease
  website
  other
}

class Organization {
  +id: string
  +name: string
  +type: OrganizationType
}

enum OrganizationType {
  municipality
  jointMunicipality
  district
  committee
  council
  authority
  association
}

class Category {
  +id: string
  +name: string
}

class Position {
  +organization: string
  +summary: string
  +sourceUrl: uri
}

Topic "1" o-- "0..*" ImpactLocation
Topic "1" o-- "0..*" Milestone
Topic "1" o-- "1..*" Source
Topic "*" -- "*" Organization
Topic "*" -- "*" Category
Topic "1" o-- "0..*" Position
Dataset ..> Topic : topics input
Dataset ..> ImpactLocation : GeoJSON input
View "1" o-- "1..*" Layer
View "1" o-- "1" MapConfiguration
Layer "*" --> "1" Dataset : reads >
Layer "1" o-- "0..1" ViewFilter
Layer "1" o-- "1" Presentation

@enduml
