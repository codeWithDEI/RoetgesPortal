@startuml
title RötgesPortal – Current System Architecture

skinparam componentStyle rectangle
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 40

actor "Editors" as Editor
actor "Citizens" as Citizen
actor "Operator" as Operator

cloud "GitHub Repository" {
  package "Content pipeline" {
    file "Editorial YAML\ntopics, areas, datasets, views" as Content
    file "Location GeoJSON" as Locations
    file "JSON Schemas" as Schemas
    component "Content Validator" as Validator
    component "Portal Generator" as Generator
    file "Generated runtime artifacts\nJSON, GeoJSON, search index" as Generated
  }

  package "Application and operations" {
    file "Web application" as WebSource
    file "Docker Compose and Caddy configuration" as Deployment
  }
}

component "GitHub Actions\nValidation" as Pipeline

node "Production VPS" as Hosting {
  component "Caddy\nTLS and redirects" as Caddy
  component "Stateless RötgesPortal\nWeb App" as Portal
  file "Bundled runtime data\nJSON, GeoJSON, search index" as RuntimeData
  file "Privacy-reduced\naccess logs" as AccessLogs
  component "GoAccess\nreport generator" as Analytics
  component "Private analytics\ndashboard" as Dashboard
}

cloud "OpenStreetMap" as OSM
cloud "Public Sources" as Sources {
  component "Council Information System"
  component "Municipal Websites"
  component "Public Documents"
}

Editor --> Content : maintain reviewed content
Editor --> Locations : maintain geographic impact
Content --> Validator
Locations --> Validator
Schemas --> Validator : contracts
Validator --> Generator : validated content
Generator --> Generated

Pipeline --> Validator : on commit / PR
Pipeline --> WebSource : build, test, and lint
Pipeline --> Deployment : validate configuration
Operator --> Hosting : deploy reviewed\nmain commit

Citizen --> Caddy : browse, search,\nfilter, and map over HTTPS
Caddy --> Portal : internal network
WebSource ..> Portal : built application
Deployment ..> Hosting : Compose configuration
Generated ..> RuntimeData : packaged with release
Portal --> RuntimeData : read-only
Portal --> OSM : map tiles when required
Caddy --> AccessLogs : sanitized page requests
AccessLogs --> Analytics
Analytics --> Dashboard
Operator --> Dashboard : SSH tunnel only

Content ..> Sources : source links

@enduml
