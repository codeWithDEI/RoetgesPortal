@startuml
title RötgesPortal – MVP System Architecture

skinparam componentStyle rectangle
skinparam shadowing false

actor "Editors" as Editor
actor "Citizens" as Citizen

cloud "GitHub Repository" {
  folder "Editorial Content" {
    file "content/topics/*.yaml" as Topics
    file "content/locations/*.geojson" as Locations
  }

  folder "Content Contracts" {
    file "schemas/topic.schema.json" as TopicSchema
  }

  folder "Build" {
    component "Content Validator" as Validator
    component "Portal Generator" as Generator
    file "topics.json" as TopicsJson
    file "map.geojson" as MapGeoJson
    file "search-index.json" as SearchIndex
  }
}

component "GitHub Actions\nCI/CD" as Pipeline

node "Static Hosting" as Hosting {
  component "RötgesPortal Web App" as Portal
}

cloud "OpenStreetMap" as OSM
cloud "Public Sources" as Sources {
  component "Council Information System" as RIS
  component "Municipal Websites" as Municipality
  component "Public Documents" as Documents
}

Editor --> Topics : maintain topics
Editor --> Locations : maintain geographic impact

Topics --> Validator
Locations --> Validator
TopicSchema --> Validator : schema
Validator --> Generator : validated content
Generator --> TopicsJson
Generator --> MapGeoJson
Generator --> SearchIndex

Pipeline --> Validator : on commit / PR
Pipeline --> Generator : after validation
Pipeline --> Hosting : Deployment

Citizen --> Portal : read, filter,\nview map
Portal --> TopicsJson
Portal --> MapGeoJson
Portal --> SearchIndex
Portal --> OSM : map tiles

Topics ..> RIS : source links
Topics ..> Municipality : source links
Topics ..> Documents : source links

@enduml
