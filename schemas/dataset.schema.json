{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roetgesportal.example/schemas/dataset.schema.json",
  "title": "RötgesPortal dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "type", "path"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["topics", "geojson"]
    },
    "path": {
      "type": "string",
      "pattern": "^content/(topics|locations(?:/[a-zA-Z0-9._-]+)+)$"
    },
    "normalization": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {"const": "topics"}
        }
      },
      "then": {
        "properties": {
          "path": {"const": "content/topics"},
          "normalization": {"const": "none"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {"const": "geojson"}
        }
      },
      "then": {
        "properties": {
          "path": {
            "pattern": "^content/locations(?:/[a-zA-Z0-9._-]+)+\\.geojson$"
          }
        }
      }
    }
  ]
}
