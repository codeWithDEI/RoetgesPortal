{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roetgesportal.example/schemas/view.schema.json",
  "title": "RötgesPortal map view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "route",
    "visibility",
    "map",
    "layers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:[/-][a-z0-9]+)*$"
    },
    "visibility": {
      "enum": ["draft", "published", "archived"]
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "zoom"],
      "properties": {
        "center": {
          "type": "object",
          "additionalProperties": false,
          "required": ["longitude", "latitude"],
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          }
        },
        "zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22
        },
        "minZoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22
        },
        "maxZoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "dataset",
          "visibleByDefault",
          "clustering",
          "presentation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dataset": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "visibleByDefault": {
            "type": "boolean"
          },
          "clustering": {
            "type": "boolean"
          },
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visibility": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["draft", "published", "archived"]
                }
              },
              "status": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "idea",
                    "announced",
                    "consultation",
                    "committee",
                    "council",
                    "decided",
                    "implementation",
                    "completed",
                    "paused",
                    "rejected"
                  ]
                }
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "organizations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string"}
              }
            }
          },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preset"],
            "properties": {
              "preset": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    }
  }
}
